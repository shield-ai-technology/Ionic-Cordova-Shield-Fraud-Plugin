<?xml version='1.0' encoding='utf-8'?>
<widget id="com.shieldfraud.example" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Plugin Example App</name>
    <description>SHIELD Fraud Ionic-Cordova Plugin Example Application</description>
    <author email="support@shield.com" href="https://shield.com">
        SHIELD Team
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="AndroidXEnabled" value="true" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
    <preference name="DisallowOverscroll" value="false" />
    <preference name="StatusBarBackgroundColor" value="#012856" />
    <engine name="android" spec="^14.0.1" />
    <engine name="ios" spec="^8.0.1" />
    <hook type="before_prepare" src="hooks/load-env.js" />
</widget>
